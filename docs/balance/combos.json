ide","hardest_boss_score":51.1},{"id":"explorer-mage-warrior","profile":"Explorer","pair":"Mage + Warrior","primary":"Mage","secondary":"Warrior","runs":3,"avg_score":21.8,"boss_score":31,"boss_arc1":21.1,"boss_arc2":21.9,"boss_arc3":26.6,"boss_arc4":35,"boss_arc5":50.6,"losses_per_run":23.7,"final_level":227,"hardest_boss_realm":"47. Dreamreach","hardest_boss_score":72.8},{"id":"explorer-mage-priest","profile":"Explorer","pair":"Mage + Priest","primary":"Mage","secondary":"Priest","runs":3,"avg_score":9.5,"boss_score":17.3,"boss_arc1":11.4,"boss_arc2":9.7,"boss_arc3":31,"boss_arc4":19.4,"boss_arc5":14.9,"losses_per_run":0,"final_level":214,"hardest_boss_realm":"25. Duneheart Sanctum","hardest_boss_score":50.7},{"id":"explorer-priest-assassin","profile":"Explorer","pair":"Priest + Assassin","primary":"Priest","secondary":"Assassin","runs":3,"avg_score":17.5,"boss_score":24.1,"boss_arc1":18.6,"boss_arc2":11.5,"boss_arc3":35.9,"boss_arc4":38.3,"boss_arc5":16.4,"losses_per_run":5,"final_level":215,"hardest_boss_realm":"36. Veilwood","hardest_boss_score":69},{"id":"explorer-priest-guardian","profile":"Explorer","pair":"Priest + Guardian","primary":"Priest","secondary":"Guardian","runs":3,"avg_score":10.3,"boss_score":12.7,"boss_arc1":6.4,"boss_arc2":3.3,"boss_arc3":17,"boss_arc4":19.9,"boss_arc5":17.1,"losses_per_run":1,"final_level":215,"hardest_boss_realm":"43. Gloomspore Depths","hardest_boss_score":33.9},{"id":"explorer-priest-warrior","profile":"Explorer","pair":"Priest + Warrior","primary":"Priest","secondary":"Warrior","runs":3,"avg_score":16.1,"boss_score":21.2,"boss_arc1":17.7,"boss_arc2":12.6,"boss_arc3":33.1,"boss_arc4":22.3,"boss_arc5":20.3,"losses_per_run":5.7,"final_level":216,"hardest_boss_realm":"24. Petalfall Isles","hardest_boss_score":57},{"id":"explorer-priest-mage","profile":"Explorer","pair":"Priest + Mage","primary":"Priest","secondary":"Mage","runs":3,"avg_score":11.1,"boss_score":19,"boss_arc1":10,"boss_arc2":11.2,"boss_arc3":29.9,"boss_arc4":25.2,"boss_arc5":19,"losses_per_run":1.7,"final_level":215,"hardest_boss_realm":"30. Nihil's Threshold","hardest_boss_score":55.5}],"meta":[{"label":"export-report.js","value":"// Builds the balance-report datasets from tools/sim.js output.\n// Usage: node tools/export-report.js story.json explorer.json outDir\n// Writes outDir/combos.json (one row per profile × class pair) and outDir/stages.json (one row per profile × pair × realm × shrine).\n// Difficulty score per shrine battle, 0–100, averaged over runs:\n//   60 × (1 − lowest hero HP during the winning fight) + 30 × min(1, losses before winning ÷ 2) + 10 × min(1, companions knocked out ÷ 2)\nconst fs = require('fs'), path = require('path');\nconst [storyFile, explorerFile, outDir] = process.argv.slice(2);\nconst SELF = fs.readFileSync(__filename, 'utf8');\nconst ctx = {}; require('vm').runInNewContext(['data.js', 'realms/arc1.js', 'realms/arc2.js', 'realms/arc3.js', 'realms/arc4.js', 'realms/arc5.js']\n  .map(f => fs.readFileSync(path.join(__dirname, '..', f), 'utf8')).join('\\n') + ';this.DV = DV;', ctx);\nconst DV = ctx.DV, cap = s => s[0].toUpperCase() + s.slice(1);\nconst score = x => Math.min(100, 60 * (1 - x.lo) + 30 * Math.min(1, (x.tries - 1) / 2) + 10 * Math.min(1, x.ko / 2));\nconst mean = a => a.reduce((t, x) => t + x, 0) / a.length, r1 = v => Math.round(v * 10) / 10;\nconst combos = [], stages = [];\nfor (const [profile, file] of [['Story path', storyFile], ['Explorer', explorerFile]]) {\n  const sim = JSON.parse(fs.readFileSync(file)), pid = profile === 'Story path' ? 'story' : 'explorer';\n  for (const key of Object.keys(sim)) {\n    const [p, s] = key.split('+'), runs = sim[key].map(r => r.rows.filter(x => !x.stuck)), pair = `${cap(p)} + ${cap(s)}`;\n    const cell = (w, st) => runs.map(rows => rows.find(x => x.w === w && x.s === st)).filter(Boolean);\n    let all = [], boss = [], arcStage = [[], [], [], [], []], arcBoss = [[], [], [], [], []];\n    for (let w = 1; w <= 50; w++) for (let st = 0; st < 5; st++) {\n      const c = cell(w, st); if (!c.length) continue;\n      const sc = r1(mean(c.map(score))), losses = r1(mean(c.map(x => x.tries - 1))), a = DV.arcOf(w) - 1;\n      stages.push({ id:`${pid}-${p}-${s}-${w}-${st + 1}`, profile, pair, realm:w, realm_name:DV.WORLDS[w - 1].name, arc:a + 1, shrine:st + 1,\n        battle: st === 4 ? 'Boss' : 'Stage', score:sc, losses, rounds:Math.round(mean(c.map(x => x.rounds))), hero_level:Math.round(mean(c.map(x => x.lvl))) });\n      all.push(sc); arcStage[a].push(sc); if (st === 4) { boss.push({ w, sc }); arcBoss[a].push(sc); }\n    }\n    const hardest = boss.reduce((m, b) => b.sc > m.sc ? b : m, boss[0]);\n    combos.push({ id:`${pid}-${p}-${s}`, profile, pair, primary:cap(p), secondary:cap(s), runs:runs.length,\n      avg_score:r1(mean(all)), boss_score:r1(mean(boss.map(b => b.sc))),\n      boss_arc1:r1(mean(arcBoss[0])), boss_arc2:r1(mean(arcBoss[1])), boss_arc3:r1(mean(arcBoss[2])), boss_arc4:r1(mean(arcBoss[3])), boss_arc5:r1(mean(arcBoss[4])),\n      losses_per_run:r1(mean(runs.map(rows => rows.reduce((t, x) => t + x.tries - 1, 0)))),\n      final_level:Math.round(mean(sim[key].map(r => r.level))), hardest_boss_realm:`${hardest.w}. ${DV.WORLDS[hardest.w - 1].name}`, hardest_boss_score:hardest.sc });\n  }\n}\nconst meta = [{ label:'export-report.js', value:SELF, type:'code', lang:'javascript' },\n  { label:'Input', value:'tools/sim.js output: 3 runs of every primary + secondary class pair (20 pairs) through all 50 realms, for the Story path and Explorer profiles.' }];\nfs.mkdirSync(outDir, { recursive:true });\nfs.writeFileSync(path.join(outDir, 'combos.json'), JSON.stringify({ rows:combos, meta }));\nfs.writeFileSync(path.join(outDir, 'stages.json'), JSON.stringify({ rows:stages, meta }));\nconsole.log(`combos ${combos.length} rows, stages ${stages.length} rows → ${outDir}`);\n","type":"code","lang":"javascript"},{"label":"Input","value":"tools/sim.js output: 3 runs of every primary + secondary class pair (20 pairs) through all 50 realms, for the Story path and Explorer profiles."}]}